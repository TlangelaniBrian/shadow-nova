# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shadownova
DATABASE_URL=postgres://user:changeme@localhost:5432/shadownova?sslmode=disable

# Database connection pool configuration
DB_MAX_CONNS=25          # Maximum concurrent connections
DB_MIN_CONNS=5           # Minimum idle connections
DB_CONNECT_TIMEOUT=5     # Connection timeout in seconds
DB_TX_TIMEOUT=30s        # Maximum transaction duration

# Authentication
JWT_SECRET=changeme-generate-a-strong-secret
ADMIN_DEFAULT_PASSWORD=changeme

# CSRF Protection (32 bytes)
# Generate with: openssl rand -base64 32
CSRF_KEY=

# Encryption key for sensitive data (32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# AI
GEMINI_API_KEY=

# Grafana
GF_ADMIN_PASSWORD=changeme

# Unleash (Feature Flags)
UNLEASH_URL=http://unleash:4242
UNLEASH_API_TOKEN=
UNLEASH_FRONTEND_TOKEN=
