{
  "dashboard": {
    "title": "Shadow Nova - Business Metrics",
    "tags": ["business", "metrics", "kpi"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "User Registrations",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(user_registrations_total[5m]) * 300",
            "legendFormat": "Registrations per 5min"
          }
        ],
        "yaxes": [
          {"label": "Registrations", "format": "short"},
          {"show": false}
        ]
      },
      {
        "id": 2,
        "title": "User Logins by Method",
        "type": "piechart",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(user_logins_total) by (method)",
            "legendFormat": "{{method}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Lesson Completions by Content Type",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(lesson_completions_total[5m]) * 300",
            "legendFormat": "{{content_type}}"
          }
        ],
        "yaxes": [
          {"label": "Completions per 5min", "format": "short"},
          {"show": false}
        ]
      },
      {
        "id": 4,
        "title": "Learning Path Completions",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(learning_path_completions_total) by (difficulty)",
            "legendFormat": "{{difficulty}}"
          }
        ],
        "yaxes": [
          {"label": "Completions", "format": "short"},
          {"show": false}
        ]
      },
      {
        "id": 5,
        "title": "Project Submissions Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(project_submissions_total[5m]) * 300",
            "legendFormat": "Submissions per 5min"
          }
        ],
        "yaxes": [
          {"label": "Submissions", "format": "short"},
          {"show": false}
        ]
      },
      {
        "id": 6,
        "title": "Project Status Updates",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(project_status_updates_total) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "yaxes": [
          {"label": "Updates", "format": "short"},
          {"show": false}
        ]
      },
      {
        "id": 7,
        "title": "Content Items Collected",
        "type": "stat",
        "gridPos": {"x": 0, "y": 24, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "content_items_collected_total",
            "legendFormat": "Total Items"
          }
        ]
      },
      {
        "id": 8,
        "title": "AI Processing Duration (p50, p95, p99)",
        "type": "graph",
        "gridPos": {"x": 6, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(ai_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(ai_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(ai_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {"label": "Duration (seconds)", "format": "s"},
          {"show": false}
        ]
      },
      {
        "id": 9,
        "title": "AI Processing Error Rate",
        "type": "graph",
        "gridPos": {"x": 18, "y": 24, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_processing_errors_total[5m]) * 300",
            "legendFormat": "Errors per 5min"
          }
        ],
        "yaxes": [
          {"label": "Errors", "format": "short"},
          {"show": false}
        ],
        "alert": {
          "name": "High AI Processing Error Rate",
          "conditions": [
            {
              "evaluator": {"params": [5], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "AI processing error rate is above 5 errors per 5 minutes",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 10,
        "title": "Daily Active Users (Logins)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(increase(user_logins_total[24h]))",
            "legendFormat": "DAU"
          }
        ]
      },
      {
        "id": 11,
        "title": "Total Registrations",
        "type": "stat",
        "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "user_registrations_total",
            "legendFormat": "Total Users"
          }
        ]
      },
      {
        "id": 12,
        "title": "Total Project Submissions",
        "type": "stat",
        "gridPos": {"x": 12, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "project_submissions_total",
            "legendFormat": "Total Submissions"
          }
        ]
      },
      {
        "id": 13,
        "title": "Total Lesson Completions",
        "type": "stat",
        "gridPos": {"x": 18, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(lesson_completions_total)",
            "legendFormat": "Total Completions"
          }
        ]
      }
    ],
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 1
  }
}
